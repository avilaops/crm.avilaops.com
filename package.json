{
  "name": "agenda-crm",
  "private": true,
  "version": "0.1.0",
  "description": "CRM multi-tenant da Avila Ops para vendas e atendimento omnichannel.",
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.16.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avilaops/agenda.git"
  },
  "agenda": {
    "project": true,
    "healthUrl": "http://127.0.0.1:3000/api/health"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "tsx backend/server.ts",
    "dev:full": "concurrently --names api,web --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "db:migrate": "tsx backend/migrate.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "npm run cli:test",
    "check": "npm run typecheck && npm run lint && npm test",
    "validate": "npm run check && npm run build",
    "preview": "vite preview",
    "doctor": "node packages/cli/bin/agenda.js doctor",
    "health": "node packages/cli/bin/agenda.js health",
    "docker:build": "docker compose -f docker-compose.production.yml build",
    "docker:up": "docker compose -f docker-compose.production.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.production.yml down",
    "docker:status": "docker compose -f docker-compose.production.yml ps",
    "docker:logs": "docker compose -f docker-compose.production.yml logs -f app",
    "docker:migrate": "docker compose -f docker-compose.production.yml exec app npm run db:migrate",
    "worker:install": "npm ci --prefix worker",
    "worker:dev": "npm --prefix worker run dev",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "worker:deploy": "npm --prefix worker run deploy",
    "cli": "node packages/cli/bin/agenda.js",
    "cli:test": "npm test --workspace @avilaops/agenda-cli",
    "cli:pack": "npm pack --workspace @avilaops/agenda-cli --dry-run",
    "cli:publish": "node scripts/publish-cli.mjs",
    "cli:release": "node scripts/release-cli.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "lucide-react": "^1.26.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
