# Aplicacao local
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agenda_crm
DEFAULT_TENANT_SLUG=avila-ops

# Gere valores longos e exclusivos. Nunca reutilize valores de producao.
SETUP_TOKEN=troque-por-um-token-local
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-local
ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-local
ENCRYPTION_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Worker que conclui o OAuth da Meta durante o desenvolvimento.
VITE_META_WORKER_URL=http://127.0.0.1:8787

# Anexos do WhatsApp. O diretorio precisa estar num volume persistente: o
# arquivo e servido por /api/media/:id/content muito depois do atendimento.
MEDIA_DIR=./storage/media
MEDIA_MAX_BYTES=16777216
