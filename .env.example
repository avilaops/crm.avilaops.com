# Aplicacao local
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agenda_crm
DEFAULT_TENANT_SLUG=avila-ops

# Gere valores longos e exclusivos. Nunca reutilize valores de producao.
SETUP_TOKEN=troque-por-um-token-local
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-local
ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-local
ENCRYPTION_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Anexos do WhatsApp. O diretorio precisa estar num volume persistente: o
# arquivo e servido por /api/media/:id/content muito depois do atendimento.
MEDIA_DIR=./storage/media
MEDIA_MAX_BYTES=16777216

# SSO (auth.avilaops.com) — opcional.
# Sem SSO_JWT_SECRET o CRM ignora o SSO: /api/auth/sso/enabled responde
# false e a tela mostra so o formulario de e-mail e senha.
#
# O valor tem de ser IDENTICO ao SSO_JWT_SECRET do auth.avilaops.com.
#
# Quem tem conta @avilaops.com (papel ADMIN) entra direto, com usuario criado
# no tenant padrao. Os demais precisam ja ter cadastro em `users` — o SSO
# autentica, mas nao concede acesso ao CRM por conta propria.
SSO_JWT_SECRET=
SSO_BASE_URL=https://auth.avilaops.com
CRM_BASE_URL=https://crm.avilaops.com

# Conta da Meta. A conexão do cliente com a Meta mora no auth.avilaops.com e o
# CRM a lê por lá. As duas variáveis são o identificador e o segredo de uma
# integração criada no painel do auth (/admin/integracoes) com a permissão de
# ler a Meta. Sem elas a tela mostra que este ambiente não está ligado.
# A mesma integração convida quem entra na equipe (backend/auth-convite.ts):
# o auth cria a conta, libera o CRM e escreve o e-mail do convite. Sem elas o
# usuário é criado e a tela avisa que o convite não saiu.
AUTH_META_CLIENT_ID=
AUTH_META_CLIENT_SECRET=

# Contato da equipe Ávila Ops nos caminhos assistidos (conectar o WhatsApp,
# contratar plano). Sem eles a tela não mostra link: orienta a falar com quem
# administra a conta. WhatsApp só com dígitos, com DDI.
VITE_SUPORTE_WHATSAPP=
VITE_SUPORTE_EMAIL=

# Google Agenda (OAuth). Sem CLIENT_ID e SECRET a conexão responde que não está
# configurada neste ambiente. ENCRYPTION_KEY precisa ter ao menos 32 caracteres.
# PUBLIC_APP_URL deve ser a origem HTTPS em produção, sem caminho/query/fragment.
# Cadastre essa origem + /api/integrations/google/callback no cliente OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:3000

