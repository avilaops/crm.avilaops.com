# URL do Worker que faz a troca do código OAuth da Meta pelo token.
# Em dev local (wrangler dev), o padrão já é http://localhost:8787.
VITE_META_WORKER_URL=http://localhost:8787

# Em produção, use a URL publicada pelo Cloudflare Worker.
# VITE_META_WORKER_URL=https://agenda-meta-oauth.<sua-conta>.workers.dev
